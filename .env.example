# =====================================================================
# SUPER.INTELLIGENCEEE ENVIRONMENT CONFIGURATION
# =====================================================================
# Note: The system runs 100% locally with zero budget and requires NO paid keys.
# Optional free-tier keys or local endpoints can be configured below.

# Environment Mode
SUPER_ENV=development
SUPER_PORT=5000
SUPER_HOST=127.0.0.1

# Optional AI Providers (System gracefully falls back to deterministic local templates)
# GEMINI_API_KEY=your_free_gemini_api_key_here
# OLLAMA_HOST=http://localhost:11434

# =====================================================================
# YouTube Data API v3 & Google OAuth 2.0 Configuration
# =====================================================================
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized JavaScript origin: http://127.0.0.1:5000
# Authorized redirect URI: http://127.0.0.1:5000/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:5000/auth/youtube/callback
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.upload,https://www.googleapis.com/auth/youtube.readonly

# =====================================================================
# Meta Instagram API — Unified Login Configuration
# =====================================================================
# Meta App Dashboard -> Use Case: "Manage messaging & content on Instagram"
# Configuration ID: Unified Login / Facebook Login for Business
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_CONFIG_ID=1681040066712391
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:5000/oauth/instagram/callback
# Optional 32-byte base64 encryption key (auto-generated in data/secure/.master_key if omitted)
# INSTAGRAM_ENCRYPTION_KEY=

# Legacy Environment Fallback (Optional)
# INSTAGRAM_ACCOUNT_ID=
# INSTAGRAM_ACCESS_TOKEN=

# System Settings
LOG_LEVEL=INFO
MAX_CONCURRENT_RENDERS=1
CLEANUP_TEMP_FILES=true
