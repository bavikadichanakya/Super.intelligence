# =====================================================================
# SUPER.INTELLIGENCEEE ENVIRONMENT CONFIGURATION
# =====================================================================
# Note: The system runs 100% locally with zero budget and requires NO paid keys.
# Optional free-tier keys or local endpoints can be configured below.

# Environment Mode
SUPER_ENV=development
SUPER_PORT=5000
SUPER_HOST=127.0.0.1

# Optional AI Providers (System gracefully falls back to deterministic local templates)
# GEMINI_API_KEY=your_free_gemini_api_key_here
# OLLAMA_HOST=http://localhost:11434

# Meta Instagram API — Unified Login Configuration
# Configure your Meta App credentials created in Meta App Dashboard
# Use Case: "Manage messaging & content on Instagram" -> "API setup with Unified login"
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_CONFIG_ID=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:5000/oauth/instagram/callback
# Optional 32-byte base64 encryption key (auto-generated on first run if omitted)
# INSTAGRAM_ENCRYPTION_KEY=

# Legacy Environment Fallback (Optional)
# INSTAGRAM_ACCOUNT_ID=
# INSTAGRAM_ACCESS_TOKEN=

# System Settings
LOG_LEVEL=INFO
MAX_CONCURRENT_RENDERS=1
CLEANUP_TEMP_FILES=true
