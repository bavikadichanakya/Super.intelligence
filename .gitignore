# SUPER.INTELLIGENCEEE .gitignore

# Environment & Secrets (NEVER COMMIT)
.env
*.env
*.token.json
credentials.json
client_secret*.json
data/secure/
.master_key
*.enc

# SQLite Databases & Local Runtime Storage
*.db
*.db-journal
*.sqlite
*.sqlite3
data/*.db

# Python & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
env/
venv/

# Runtimes, Logs & Temp
.temp/
.external_repos/
external/
logs/
*.log
bin/
node_modules/
rendering/remotion/node_modules/
rendering/remotion/.remotion/
data/tunnel_url.txt
data/ngrok_url.txt
scratch/

# Large Model Binaries & Audio Models
*.onnx
reports/forensic_scan_raw.json

# Generated Media Outputs & Scratch
output/
renderer/assets/reel_*
renderer/assets/test_*
renderer/assets/vr_test_*
renderer/compositions/reel_*
data/scripts/*.json
data/scripts/*.md
assets/voices/*.wav
*.mp4
*.mov
*.webm
*.mkv

# OS Specific & Archives
.DS_Store
Thumbs.db
*.zip
*.tar.gz
*.tgz
sketch-skill/
